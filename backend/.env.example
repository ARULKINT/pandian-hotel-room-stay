# Copy to backend/.env and set your own values. backend/.env is gitignored.

# Password for the staff Operations panel (#/admin).
# If this is not set, the server generates a random one on each boot and
# prints it to the console.
ADMIN_PASSWORD=change-me-before-deploying

# Port the API listens on.
PORT=3000

# Allowed browser origin. Use your real site origin in production
# instead of the "*" default.
CORS_ORIGIN=http://localhost:5173

# Optional. Postgres connection string (e.g. from a free Neon or Supabase
# project) for bookings to survive redeploys in production. Leave unset for
# local dev — bookings then persist to backend/data/bookings.json instead.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
